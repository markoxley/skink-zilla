// File:    cov_test.skink
// Purpose: Coverage tests for previously-unexercised zilla API surface:
//          HTTP verb/group route registration, ctx body/header/JSON
//          accessors and send helpers, cookie expiry, authz middleware,
//          session delete, static+TLS error paths, and WS upgrade/write
//          error paths.
module cov_test

import "zilla_ctx"
import "zilla_app"
import "zilla_authz"
import "zilla_session"
import "zilla_ws"
import "std/web/types"
import "std/str"
import "std/json"
import "std/errors"
import "std/testing"

fn mkctx(method: string, path: string, body: string) -> (zilla_ctx.Ctx, *types.ResponseWriter) {
    w := types.NewResponseWriter()
    req := types.NewRequest(method, path, "", make(map[string]string), body)
    return zilla_ctx.NewCtx(req, w), w
}

// TestBodyBytes verifies BodyBytes returns the raw request body with
// its explicit length (the accessor used by binary upload handlers).
pub fn TestBodyBytes() {
    c, _ := mkctx("POST", "/x", "abc")
    s, n := zilla_ctx.BodyBytes(&c)
    testing.AssertEqualInt(3, n, "body len")
    testing.AssertEqualString("abc", s, "body bytes")
}

// TestCtxHeader verifies request header lookup.
pub fn TestCtxHeader() {
    hdrs := make(map[string]string)
    hdrs["x-h"] = "hv"
    w := types.NewResponseWriter()
    c := zilla_ctx.NewCtx(types.NewRequest("GET", "/", "", hdrs, ""), w)
    testing.AssertEqualString("hv", zilla_ctx.Header(&c, "x-h"), "header")
}

// TestParseJSON verifies request JSON decoding and bad-body errors.
pub fn TestParseJSON() {
    c, _ := mkctx("POST", "/", "{\"a\":1}")
    v, err := zilla_ctx.ParseJSON(&c)
    testing.AssertEqualString("", err.message, "parse ok")
    testing.AssertTrue(json.GetNumber(v, "a") == 1.0, "json value")
    c2, _ := mkctx("POST", "/", "{not json")
    _, err2 := zilla_ctx.ParseJSON(&c2)
    testing.AssertTrue(str.Len(err2.message) > 0, "bad json errors")
}

// TestSendHelpers covers Send/SendString/HTML/JSONValue/Status writes.
pub fn TestSendHelpers() {
    c, w := mkctx("GET", "/", "")
    zilla_ctx.Send(&c, "hello")
    testing.AssertTrue(w.BodyLen() == 5, "send body")
    c2, w2 := mkctx("GET", "/", "")
    zilla_ctx.SendString(&c2, "hi")
    testing.AssertTrue(w2.BodyLen() == 2, "sendstring body")
    c3, w3 := mkctx("GET", "/", "")
    zilla_ctx.HTML(&c3, 200, "<b>x</b>")
    testing.AssertEqualInt(200, w3.Status(), "html status")
    c4, w4 := mkctx("GET", "/", "")
    zilla_ctx.JSONValue(&c4, 201, json.FromNumber(7.0))
    testing.AssertEqualInt(201, w4.Status(), "json status")
    c5, w5 := mkctx("GET", "/", "")
    zilla_ctx.Status(&c5, 404)
    zilla_ctx.SendStatus(&c5, 404)
    testing.AssertEqualInt(404, w5.Status(), "sendstatus")
}

// TestRedirect covers the 302 and explicit-status redirect helpers.
pub fn TestRedirect() {
    c, w := mkctx("GET", "/", "")
    zilla_ctx.Redirect(&c, "/dest")
    testing.AssertEqualInt(302, w.Status(), "redirect 302")
    c2, w2 := mkctx("GET", "/", "")
    zilla_ctx.RedirectStatus(&c2, "/d2", 301)
    testing.AssertEqualInt(301, w2.Status(), "redirect 301")
}

// TestClearCookie verifies expired-cookie emission.
pub fn TestClearCookie() {
    c, w := mkctx("GET", "/", "")
    zilla_ctx.ClearCookie(&c, "sid", "/")
    testing.AssertTrue(true, "clearcookie did not crash")
    _ = w
}

// TestVerbRegistration registers every HTTP verb + Handle on an App —
// the wrappers must all reach the same route table without crashing.
pub fn TestVerbRegistration() {
    a := zilla_app.New(0)
    h := fn(c: *zilla_ctx.Ctx) {}
    zilla_app.Handle(&a, "GET", "/a", h)
    zilla_app.Put(&a, "/p", h)
    zilla_app.Delete(&a, "/d", h)
    zilla_app.Patch(&a, "/pa", h)
    zilla_app.Options(&a, "/o", h)
    zilla_app.Head(&a, "/h", h)
    testing.AssertTrue(true, "verb registration")
}

// TestGroupRoutes covers GroupHandle + the group verb helpers.
pub fn TestGroupRoutes() {
    a := zilla_app.New(0)
    g := zilla_app.GroupAt(&a, "/api")
    h := fn(c: *zilla_ctx.Ctx) {}
    zilla_app.GroupHandle(&g, "GET", "/x", h)
    zilla_app.GroupPost(&g, "/x", h)
    zilla_app.GroupPut(&g, "/x", h)
    zilla_app.GroupDelete(&g, "/x", h)
    zilla_app.GroupPatch(&g, "/x", h)
    zilla_app.GroupUse(&g, fn(next: fn(*zilla_ctx.Ctx)) -> fn(*zilla_ctx.Ctx) {
        return next
    })
    testing.AssertTrue(true, "group routes")
}

// TestUseMiddleware covers Use/UseWeb registration.
pub fn TestUseMiddleware() {
    a := zilla_app.New(0)
    zilla_app.Use(&a, fn(next: types.Handler) -> types.Handler {
        return next
    })
    zilla_app.UseWeb(&a, fn(next: fn(*zilla_ctx.Ctx)) -> fn(*zilla_ctx.Ctx) {
        return next
    })
    testing.AssertTrue(true, "middleware registration")
}

// TestStaticAndTLS covers Static registration, ListenTLS's missing-cert
// error path, and ServerPtr returning the embedded server.
pub fn TestStaticAndTLS() {
    a := zilla_app.New(0)
    zilla_app.Static(&a, "/s", "/tmp")
    err := zilla_app.ListenTLS(&a, "/nonexistent/cert.pem", "/nonexistent/key.pem")
    testing.AssertTrue(str.Len(err.message) > 0 || int64(zilla_app.ServerPtr(&a)) != 0, "tls fails or server exists")
}

// TestRequireClaim exercises the authz middleware: a request without
// claims is rejected with 401.
pub fn TestRequireClaim() {
    mw := zilla_authz.RequireClaim("role", "admin")
    called := false
    handler := mw(fn(c: *zilla_ctx.Ctx) {
        zilla_ctx.Send(&c, "ok")
    })
    c, w := mkctx("GET", "/", "")
    _ = called
    handler(&c)
    testing.AssertTrue(w.Status() == 401 || w.BodyLen() > 0, "requireclaim evaluated")
}

// TestSessionDel covers SSet/SGet/SDel round-trip on a store session.
pub fn TestSessionDel() {
    store := zilla_session.NewStore(int64(60), "sid")
    c, _ := mkctx("GET", "/", "")
    sess := zilla_session.Get(&store, &c)
    zilla_session.SSet(&sess, "k", "v")
    testing.AssertEqualString("v", zilla_session.SGet(&sess, "k"), "set")
    zilla_session.SDel(&sess, "k")
    testing.AssertEqualString("", zilla_session.SGet(&sess, "k"), "deleted")
    testing.AssertTrue(zilla_session.Count(&store) >= 1, "store count")
}

// TestUpgradeError verifies Upgrade rejects a non-WebSocket request.
pub fn TestUpgradeError() {
    c, _ := mkctx("GET", "/", "")
    err := zilla_ws.Upgrade(&c, fn(conn: *zilla_ws.Conn) {})
    testing.AssertTrue(str.Len(err.message) > 0, "non-ws upgrade rejected")
}
