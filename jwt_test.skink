// File:    jwt_test.skink
// Purpose: JWT sign/verify tests — round-trip, tamper detection,
//          expiry, alg confusion ("none"), malformed tokens, and the
//          authz middleware's Bearer extraction + role gates.
module jwt_test

import "zilla_jwt"
import "zilla_authz"
import "zilla_ctx"
import "std/web/types"
import "std/str"
import "std/json"
import "std/time"
import "std/testing"

// Raw byte accessors for binary buffers — string indexing is
// bounds-checked against strlen, which truncates at the first NUL byte.
extern fn Skink_mem_byte(ptr: string, idx: int64) -> int
extern fn Skink_mem_write_byte(ptr: string, idx: int64, val: int)


// TestSignVerify checks a round-trip HS256 token.
pub fn TestSignVerify() {
    tok := zilla_jwt.Sign("{\"sub\":\"ada\",\"roles\":\"admin,user\"}", "s3cret", int64(3600))
    cl, err := zilla_jwt.Verify(tok, "s3cret")
    testing.AssertTrue(str.Len(err.message) == 0, str.Concat("verify: ", err.message))
    testing.AssertEqualString("ada", zilla_jwt.Get(&cl, "sub"), "sub claim")
    testing.AssertTrue(zilla_jwt.GetNum(&cl, "exp") > 0.0, "exp set")
    testing.AssertTrue(zilla_jwt.GetNum(&cl, "iat") > 0.0, "iat set")
}

// TestNoTTL leaves time claims alone when ttl=0.
pub fn TestNoTTL() {
    tok := zilla_jwt.Sign("{\"sub\":\"x\"}", "k", int64(0))
    cl, err := zilla_jwt.Verify(tok, "k")
    testing.AssertTrue(str.Len(err.message) == 0, "verify ok")
    testing.AssertTrue(zilla_jwt.GetNum(&cl, "exp") == 0.0, "no exp")
}

// TestTamper rejects a modified payload.
pub fn TestTamper() {
    tok := zilla_jwt.Sign("{\"sub\":\"ada\"}", "key", int64(0))
    // flip a payload char
    d1 := str.IndexOf(tok, ".")
    rest := str.Substr(tok, d1 + 1, str.Len(tok) - d1 - 1)
    d2 := str.IndexOf(rest, ".")
    pay := str.Substr(rest, 0, d2)
    // corrupt first payload char
    c0 := Skink_mem_byte(pay, 0)
    if c0 == 65 {
        pay = str.Concat("B", str.Substr(pay, 1, str.Len(pay) - 1))
    } else {
        pay = str.Concat("A", str.Substr(pay, 1, str.Len(pay) - 1))
    }
    bad := str.Concat(str.Substr(tok, 0, d1 + 1),
        str.Concat(pay, str.Substr(tok, d1 + 1 + d2, str.Len(tok) - d1 - 1 - d2)))
    _, err := zilla_jwt.Verify(bad, "key")
    testing.AssertTrue(str.Len(err.message) > 0, "tampered rejected")
}

// TestWrongSecret rejects a token signed with another secret.
pub fn TestWrongSecret() {
    tok := zilla_jwt.Sign("{\"sub\":\"ada\"}", "key1", int64(0))
    _, err := zilla_jwt.Verify(tok, "key2")
    testing.AssertTrue(str.Len(err.message) > 0, "wrong secret rejected")
}

// TestAlgNone rejects alg=none tokens outright.
pub fn TestAlgNone() {
    // hand-build: {"alg":"none"} . {"sub":"x"} . "" (empty sig)
    h := "eyJhbGciOiJub25lIn0"   // {"alg":"none"}
    p := "eyJzdWIiOiJ4In0"       // {"sub":"x"}
    tok := str.Concat(h, str.Concat(".", str.Concat(p, ".")))
    _, err := zilla_jwt.Verify(tok, "whatever")
    testing.AssertTrue(str.Len(err.message) > 0, "alg none rejected")
}

// TestExpiry rejects expired tokens.
pub fn TestExpired() {
    // build a token with exp in the past via claimWithTimes path:
    // Sign with ttl then hand-check by embedding exp directly.
    tok := zilla_jwt.Sign("{\"sub\":\"x\",\"exp\":1}", "k", int64(0))
    _, err := zilla_jwt.Verify(tok, "k")
    testing.AssertTrue(str.Len(err.message) > 0, "expired rejected")
}

// TestMalformed rejects non-JWT garbage.
pub fn TestMalformed() {
    _, e1 := zilla_jwt.Verify("not-a-token", "k")
    testing.AssertTrue(str.Len(e1.message) > 0, "no dots rejected")
    _, e2 := zilla_jwt.Verify("a.b", "k")
    testing.AssertTrue(str.Len(e2.message) > 0, "two segments rejected")
    _, e3 := zilla_jwt.Verify("a.b.c", "k")
    testing.AssertTrue(str.Len(e3.message) > 0, "bad b64 rejected")
}
