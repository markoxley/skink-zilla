// File:    zilla_jwt.skink
// Purpose: JSON Web Token support for skink-zilla — HS256 sign and
//          verify. Tokens are header.payload.signature with base64url
//          (no padding) segments. Verify enforces the signature AND
//          the `exp`/`nbf`/`iat` claims when present. Only HS256 is
//          supported (the dominant case for app-internal tokens);
//          alg "none" and mismatched algorithms are always rejected.
module zilla_jwt

import "std/str"
import "std/errors"
import "std/json"
import "std/base64"
import "std/crypto"
import "std/time"
import "std/strconv"

// b64url encodes n bytes of data as unpadded base64url.
fn b64url(data: string, n: int) -> string {
    s := base64.Encode(data, n)
    s = str.Replace(s, "+", "-")
    s = str.Replace(s, "/", "_")
    // strip '=' padding
    out := ""
    for i := 0; i < str.Len(s); i = i + 1 {
        if s[i] != 61 { // '='
            out = str.Concat(out, str.Substr(s, i, 1))
        }
    }
    return out
}

// b64urlDecode decodes unpadded/standard-padded base64url.
fn b64urlDecode(s: string) -> (string, errors.Error) {
    t := str.Replace(s, "-", "+")
    t = str.Replace(t, "_", "/")
    // restore padding
    rem := str.Len(t) % 4
    if rem == 2 {
        t = str.Concat(t, "==")
    } else if rem == 3 {
        t = str.Concat(t, "=")
    } else if rem == 1 {
        return "", errors.New("jwt: bad base64 length")
    }
    return base64.Decode(t)
}

// Sign creates a signed HS256 JWT. claimsJSON is a raw JSON object
// string (e.g. `{"sub":"u1"}`); `exp`/`iat` are added when ttlSecs > 0
// unless the caller already embedded them.
pub fn Sign(claimsJSON: string, secret: string, ttlSecs: int64) -> string {
    header := b64url("{\"alg\":\"HS256\",\"typ\":\"JWT\"}",
        str.Len("{\"alg\":\"HS256\",\"typ\":\"JWT\"}"))
    claims := claimsJSON
    if ttlSecs > 0 {
        now := time.Now().Unix()
        claims = claimWithTimes(claims, now, now + ttlSecs)
    }
    payload := b64url(claims, str.Len(claims))
    msg := str.Concat(header, str.Concat(".", payload))
    sig := crypto.HmacSha256Bytes(secret, str.Len(secret), msg, str.Len(msg))
    return str.Concat(msg, str.Concat(".", b64url(sig, 32)))
}

// claimWithTimes inserts iat/exp into a JSON object string (crudely —
// assumes claims is `"{ ... }"` or `"{}"`).
fn claimWithTimes(claims: string, iat: int64, exp: int64) -> string {
    ins := str.Concat("\"iat\":", str.Concat(strconv.Itoa64(iat),
        str.Concat(",\"exp\":", strconv.Itoa64(exp))))
    t := str.Trim(claims)
    if str.Len(t) >= 2 && t[0] == 123 { // '{'
        rest := str.Substr(t, 1, str.Len(t) - 1)
        if str.Len(str.Trim(rest)) == 0 {
            return str.Concat("{", str.Concat(ins, "}"))
        }
        return str.Concat("{", str.Concat(ins, str.Concat(",", rest)))
    }
    return claims
}

// Claims is the verified payload — kept as raw JSON plus a parsed view.
pub struct Claims {
    Raw:   string
    Value: json.Value
}

// Get returns a string claim ("" when absent).
pub fn Get(c: *Claims, key: string) -> string {
    return json.GetString(c.Value, key)
}

// GetNum returns a numeric claim (0 when absent).
pub fn GetNum(c: *Claims, key: string) -> float {
    return json.GetNumber(c.Value, key)
}

// Verify checks a token's signature and time claims. Returns the
// claims on success; err is empty iff ok.
pub fn Verify(token: string, secret: string) -> (Claims, errors.Error) {
    var cl Claims
    // split into 3 dot-separated segments
    d1 := str.IndexOf(token, ".")
    if d1 < 0 {
        return cl, errors.New("jwt: malformed token")
    }
    rest := str.Substr(token, d1 + 1, str.Len(token) - d1 - 1)
    d2 := str.IndexOf(rest, ".")
    if d2 < 0 {
        return cl, errors.New("jwt: malformed token")
    }
    head64 := str.Substr(token, 0, d1)
    pay64 := str.Substr(rest, 0, d2)
    sig64 := str.Substr(rest, d2 + 1, str.Len(rest) - d2 - 1)

    // header must declare HS256 — anything else (incl. "none") rejected
    hjson, herr := b64urlDecode(head64)
    if str.Len(herr.message) > 0 {
        return cl, errors.New("jwt: bad header encoding")
    }
    hv, _ := json.Unmarshal(str.Substr(hjson, 0, str.Len(hjson)))
    alg := json.GetString(hv, "alg")
    if !str.Equal(alg, "HS256") {
        return cl, errors.New("jwt: unsupported alg")
    }

    // signature check — compare HMAC over "head64.pay64"
    msg := str.Concat(head64, str.Concat(".", pay64))
    want := crypto.HmacSha256Bytes(secret, str.Len(secret), msg, str.Len(msg))
    got, derr := b64urlDecode(sig64)
    if str.Len(derr.message) > 0 {
        return cl, errors.New("jwt: bad signature encoding")
    }
    // HS256 sigs are 32 bytes — the decoded length is encoded in the
    // b64 length (sig64 unpadded): len = floor(len*3/4).
    if (str.Len(sig64) * 3) / 4 != 32 {
        return cl, errors.New("jwt: bad signature length")
    }
    if !constEq(want, got, 32) {
        return cl, errors.New("jwt: signature mismatch")
    }

    // payload
    pjson, perr := b64urlDecode(pay64)
    if str.Len(perr.message) > 0 {
        return cl, errors.New("jwt: bad payload encoding")
    }
    body := str.Substr(pjson, 0, str.Len(pjson))
    v, uerr := json.Unmarshal(body)
    if str.Len(uerr.message) > 0 {
        return cl, errors.New(str.Concat("jwt: bad payload json: ", uerr.message))
    }
    now := time.Now().Unix()
    if json.GetNumber(v, "exp") != 0.0 && int64(json.GetNumber(v, "exp")) < now {
        return cl, errors.New("jwt: expired")
    }
    if json.GetNumber(v, "nbf") != 0.0 && int64(json.GetNumber(v, "nbf")) > now {
        return cl, errors.New("jwt: not yet valid")
    }
    cl.Raw = body
    cl.Value = v
    return cl, errors.New("")
}

// constEq compares n bytes in constant time. Both sides are
// fixed-length binary buffers (HMAC output / decoded signature) —
// str.Len cannot be used as it stops at NUL bytes, so this reads raw
// offsets; any genuinely-short buffer just mismatches.
fn constEq(a: string, b: string, n: int) -> bool {
    diff := 0
    for i := 0; i < n; i = i + 1 {
        diff = diff | int(a[i] ^ b[i])
    }
    return diff == 0
}
